<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevConnect | Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('../partials/navbar') %>

    <div class="container" style="padding-top: 3rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
            <h1>My Dashboard</h1>
            <button class="btn btn-primary" id="btn-create">Create New Post</button>
        </div>

        <div id="create-section" style="display: none;" class="card">
            <h2>Write a New Blog</h2>
            <form id="post-form">
                <div class="form-group">
                    <label>Title</label>
                    <input type="text" id="title" placeholder="Enter post title..." required>
                </div>
                <div class="form-group">
                    <label>Content</label>
                    <textarea id="content" placeholder="Share your thoughts..." rows="5" required></textarea>
                </div>
                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn btn-primary">Publish Post</button>
                    <button type="button" class="btn" id="btn-cancel" style="background: var(--border);">Cancel</button>
                </div>
            </form>
        </div>

        <section>
            <h2>Your Recent Posts</h2>
            <div id="posts-container" class="post-grid">

            </div>
        </section>
    </div>

    <%- include('../partials/footer') %>

    <script>
        const createSection = document.getElementById('create-section');
        const btnCreate = document.getElementById('btn-create');
        const btnCancel = document.getElementById('btn-cancel');

        btnCreate.onclick = () => {
            createSection.style.display = 'block';
            btnCreate.style.display = 'none';
        };

        btnCancel.onclick = () => {
            createSection.style.display = 'none';
            btnCreate.style.display = 'block';
        };

        async function loadPosts() {
            const res = await fetch('/api/posts');
            const result = await res.json();
            const container = document.getElementById('posts-container');

            if (result.success) {
                let htmlContent = '';
                for (let i = 0; i < result.data.length; i++) {
                    let post = result.data[i];
                    let likesCount = 0;
                    if (post.likes) {
                        likesCount = post.likes.length;
                    }
                    htmlContent += `
                        <div class="card">
                            <h3>${post.title}</h3>
                            <p style="color: var(--text-light); margin: 1rem 0;">${post.content.substring(0, 150)}...</p>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span>❤️ ${likesCount}</span>
                                <button onclick="deletePost('${post._id}')" style="background:none; border:none; color:red; cursor:pointer; font-weight:600;">Delete</button>
                            </div>
                        </div>
                    `;
                }
                container.innerHTML = htmlContent;
            }
        }

        document.getElementById('post-form').onsubmit = async (e) => {
            e.preventDefault();
            const title = document.getElementById('title').value;
            const content = document.getElementById('content').value;

            const res = await fetch('/api/posts', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, content })
            });

            if (res.ok) {
                createSection.style.display = 'none';
                btnCreate.style.display = 'block';
                document.getElementById('post-form').reset();
                loadPosts();
            }
        };

        async function deletePost(id) {
            if (confirm('Are you sure you want to delete this post?')) {
                await fetch('/api/posts/' + id, { method: 'DELETE' });
                loadPosts();
            }
        }

        loadPosts();
    </script>
</body>
</html>
