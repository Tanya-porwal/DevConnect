<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevConnect | <%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>

    <header class="hero">
        <div class="container">
            <h1>Welcome to DevConnect</h1>
            <p>A place where developers share their thoughts and learn from each other.</p>
            <div class="hero-btns">
                <a href="/register" class="btn btn-primary">Get Started</a>
                <a href="/posts" class="btn btn-secondary">Read Blogs</a>
            </div>
        </div>
    </header>

    <section class="latest-posts">
        <div class="container">
            <div class="section-header">
                <h2>Latest Blogs</h2>
                <div class="search-box">
                    <input type="text" id="search-input" placeholder="Search blogs...">
                    <button id="search-btn" class="btn btn-primary-fill">Search</button>
                </div>
            </div>
            <div id="posts-container">
                <!-- Posts will be loaded here via JS or SSR -->
                <p>Loading posts...</p>
            </div>
        </div>
    </section>

    <%- include('../partials/footer') %>

    <script>
        async function fetchPosts(search = '') {
            const url = search ? `/api/posts?search=${search}` : '/api/posts';
            const res = await fetch(url);
            const result = await res.json();
            const container = document.getElementById('posts-container');
            
            if (result.success && result.data.length > 0) {
                container.innerHTML = result.data.map(post => `
                    <div class="post-card">
                        <h3>${post.title}</h3>
                        <p>${post.content.substring(0, 100)}...</p>
                        <div class="post-meta">
                            <span>By ${post.author.name}</span>
                            <span>❤️ ${post.likes ? post.likes.length : 0}</span>
                            <a href="/posts/${post._id}">Read More</a>
                        </div>
                    </div>
                `).join('');
            } else {
                container.innerHTML = '<p>No posts found.</p>';
            }
        }

        document.getElementById('search-btn').addEventListener('click', () => {
            const search = document.getElementById('search-input').value;
            fetchPosts(search);
        });

        document.getElementById('search-input').addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                const search = e.target.value;
                fetchPosts(search);
            }
        });

        fetchPosts();
    </script>
</body>
</html>
